<?xml version="1.0" encoding="utf-8"?>
<!-- Pomegrade: Punica's settings row, the same as the app's preference_punica.xml (shared styles in :emulator-ui's
     themes_settings.xml): at least 64 dp, 16 dp sides, 12 dp above and below the text, the icon tile, then the text,
     then the widget 12 dp after it -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Pomegrade.EmulatorSettings.Row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/icon"
        style="@style/Widget.Pomegrade.EmulatorSettings.Icon"
        android:layout_width="@dimen/emulator_settings_row_icon"
        android:layout_height="@dimen/emulator_settings_row_icon"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:tint="@color/emulator_menu_on_surface" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/text_setting_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"
            android:textAppearance="@style/TextAppearance.Pomegrade.EmulatorSettings.Title" />
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/text_setting_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"
            android:textAppearance="@style/TextAppearance.Pomegrade.EmulatorSettings.Summary" />
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/text_setting_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"
            android:textAppearance="@style/TextAppearance.Pomegrade.EmulatorSettings.Value" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_clear"
            style="@style/Widget.Pomegrade.EmulatorSettings.RowButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/use_global_setting"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
