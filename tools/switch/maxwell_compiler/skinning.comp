#version 460
// Compute replacement for Scarlet's system/skinning vertex shader (variations 0 and 1): same math,
// reading the model's vertex buffer directly instead of through vertex attributes, writing the
// transform feedback buffers' layout (position 3 x float, normal packed signed 10:10:10).
layout(local_size_x = 64) in;
// NVN storage buffers (address and size at c0[0x310 + 16 * binding]); the bones are the same memory
// the game binds as the vertex shader's constant buffer 13: 64 bytes per bone, four columns (x, y, z
// used), skinned = c0*x + c1*y + c2*z + c3.
// The patch binds the vertex buffer from the pass's first vertex with a size of count x 48 bytes, so
// the vertex count comes from the buffer size and no parameter buffer is needed.
layout(std430, binding = 0) readonly buffer Vertices { uint words[]; } vertices;  // stride 48
layout(std430, binding = 1) readonly buffer Bones { vec4 col[]; };
layout(std430, binding = 2) writeonly buffer Positions { uint w[]; } positions;   // transform feedback buffer 0
layout(std430, binding = 3) writeonly buffer Normals { uint w[]; } normals;       // transform feedback buffer 1
float h2f(uint h) {
  uint e = (h >> 10) & 0x1fu;
  uint bits = ((h & 0x8000u) << 16) | (e == 0u ? 0u : (((e + 112u) << 23) | ((h & 0x3ffu) << 13)));
  return uintBitsToFloat(bits);
}
float f(uint i) { return uintBitsToFloat(vertices.words[i]); }
void main() {
  uint v = gl_GlobalInvocationID.x;
  if (v >= uint(vertices.words.length()) / 12u) return;
  uint base = v * 12u;  // 48-byte stride in words
  vec3 p = vec3(f(base), f(base + 1u), f(base + 2u));
  uint idx = vertices.words[base + 9u];
  vec2 w01 = unpackUnorm2x16(vertices.words[base + 10u]);
  vec2 w23 = unpackUnorm2x16(vertices.words[base + 11u]);
  vec3 c0 = vec3(0), c1 = vec3(0), c2 = vec3(0), c3 = vec3(0);
#define BONE(k, wk) { uint b = ((idx >> (8 * k)) & 0xffu) * 4u; \
    c0 += wk * col[b].xyz; c1 += wk * col[b + 1u].xyz; c2 += wk * col[b + 2u].xyz; c3 += wk * col[b + 3u].xyz; }
  BONE(0, w01.x) BONE(1, w01.y) BONE(2, w23.x) BONE(3, w23.y)
  vec3 s = c0 * p.x + c1 * p.y + c2 * p.z + c3;
  positions.w[v * 3u] = floatBitsToUint(s.x);
  positions.w[v * 3u + 1u] = floatBitsToUint(s.y);
  positions.w[v * 3u + 2u] = floatBitsToUint(s.z);
#ifdef WITH_NORMAL
  {
    uint a = vertices.words[base + 3u], c = vertices.words[base + 4u];
    vec3 n = normalize(c0 * h2f(a & 0xffffu) + c1 * h2f(a >> 16) + c2 * h2f(c & 0xffffu));
    ivec3 q = ivec3(n * 511.0);
    normals.w[v] = uint(q.x & 0x3ff) | (uint(q.y & 0x3ff) << 10) | (uint(q.z & 0x3ff) << 20);
  }
#endif
}
