<?xml version="1.0" encoding="utf-8"?>
<!-- Pomegrade: the in-game menu shared with the other consoles (:emulator-ui), in place of Dolphin's own list of
     buttons; MenuFragment hides the entries the GameCube / Wii doesn't have -->
<com.google.android.material.navigation.NavigationView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/in_game_menu"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/Theme.Pomegrade.EmulatorMenu"
    app:headerLayout="@layout/emulator_menu_header"
    app:menu="@menu/emulator_menu" />
