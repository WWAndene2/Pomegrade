<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:focusable="false"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/text_header_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginHorizontal="@dimen/dolphin_spacing_large"
        android:layout_marginTop="@dimen/emulator_settings_margin"
        android:layout_marginBottom="@dimen/emulator_settings_gap"
        android:gravity="start|center_vertical"
        android:textAppearance="@style/TextAppearance.Pomegrade.EmulatorSettings.Section"
        android:textAlignment="viewStart"
        tools:text="CPU Settings" />

</RelativeLayout>
