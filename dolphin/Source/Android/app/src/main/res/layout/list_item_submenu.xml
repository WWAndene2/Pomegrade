<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="@dimen/emulator_settings_row_min_height">

    <TextView
        android:id="@+id/text_setting_name"
        android:textAppearance="@style/TextAppearance.Pomegrade.EmulatorSettings.Title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginEnd="@dimen/dolphin_spacing_large"
        android:layout_marginStart="@dimen/dolphin_spacing_large"
        android:layout_marginTop="@dimen/dolphin_spacing_large"
        android:textAlignment="viewStart"
        tools:text="Setting Name" />

</RelativeLayout>
