<?xml version="1.0" encoding="utf-8"?>
<!-- Punica's switch thumb: a 24 dp dot inside a 32 dp square (4 dp from the track's edge), white when on, grey when off -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <inset android:inset="4dp">
            <shape android:shape="oval">
                <size android:width="24dp" android:height="24dp" />
                <solid android:color="@color/emulator_menu_on_surface" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:inset="4dp">
            <shape android:shape="oval">
                <size android:width="24dp" android:height="24dp" />
                <solid android:color="@color/emulator_menu_on_surface_variant" />
            </shape>
        </inset>
    </item>
</selector>
