<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Punica's settings look (owner's choice, 13 October: the app's settings, 31 October: every console's), laid over
         a core's own settings screen (theme.applyStyle in its SettingsActivity): the dark palette, red accents, the
         page behind the cards -->
    <style name="ThemeOverlay.Pomegrade.EmulatorSettings" parent="">
        <item name="colorPrimary">@color/emulator_menu_primary</item>
        <item name="colorOnPrimary">@color/emulator_menu_on_primary</item>
        <item name="colorPrimaryContainer">@color/emulator_menu_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/emulator_menu_on_primary_container</item>
        <item name="colorSecondary">@color/emulator_menu_primary</item>
        <item name="colorSecondaryContainer">@color/emulator_menu_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/emulator_menu_on_secondary_container</item>
        <item name="colorTertiary">@color/emulator_menu_primary</item>
        <item name="colorSurface">@color/emulator_settings_background</item>
        <item name="colorSurfaceContainer">@color/emulator_menu_surface</item>
        <item name="colorSurfaceContainerLow">@color/emulator_menu_surface</item>
        <item name="colorSurfaceContainerHigh">@color/emulator_menu_surface</item>
        <item name="colorSurfaceContainerHighest">@color/emulator_menu_secondary_container</item>
        <item name="colorOnSurface">@color/emulator_menu_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/emulator_menu_on_surface_variant</item>
        <item name="colorOutline">@color/emulator_settings_line</item>
        <item name="colorOutlineVariant">@color/emulator_settings_line</item>
        <item name="android:colorBackground">@color/emulator_settings_background</item>
        <item name="android:windowBackground">@color/emulator_settings_background</item>
        <item name="android:statusBarColor">@color/emulator_settings_background</item>
        <item name="android:navigationBarColor">@color/emulator_settings_background</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Pomegrade.EmulatorMenu.Dialog</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Pomegrade.EmulatorMenu.Title</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Pomegrade.EmulatorMenu.TitleMedium</item>
    </style>

    <!-- The header (PunicaToolbar) on every console's settings, as the app's: 64 dp, transparent, 4 dp edges, the
         logo 12 dp after the back arrow -->
    <style name="Widget.Pomegrade.EmulatorSettings.Header" parent="">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:elevation">0dp</item>
        <item name="android:minHeight">@dimen/emulator_settings_header_height</item>
        <item name="android:paddingStart">@dimen/emulator_settings_header_edge</item>
        <item name="android:paddingEnd">@dimen/emulator_settings_header_edge</item>
        <item name="contentInsetStart">@dimen/emulator_settings_gap_wide</item>
        <item name="contentInsetStartWithNavigation">0dp</item>
        <item name="navigationIconTint">@color/emulator_menu_on_surface</item>
    </style>

    <!-- A settings row (the app's preference_punica.xml): at least 64 dp, 16 dp sides, 12 dp above and below the text -->
    <style name="Widget.Pomegrade.EmulatorSettings.Row" parent="">
        <item name="android:minHeight">@dimen/emulator_settings_row_min_height</item>
        <item name="android:paddingStart">@dimen/emulator_settings_margin</item>
        <item name="android:paddingEnd">@dimen/emulator_settings_margin</item>
        <item name="android:paddingTop">@dimen/emulator_settings_gap_wide</item>
        <item name="android:paddingBottom">@dimen/emulator_settings_gap_wide</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>

    <!-- A row's icon (the app's preference_punica.xml): a 16 dp glyph on a 32 dp tile, 12 dp before the text -->
    <style name="Widget.Pomegrade.EmulatorSettings.Icon" parent="">
        <item name="android:layout_width">@dimen/emulator_settings_row_icon</item>
        <item name="android:layout_height">@dimen/emulator_settings_row_icon</item>
        <item name="android:layout_marginEnd">@dimen/emulator_settings_gap_wide</item>
        <item name="android:padding">@dimen/emulator_settings_gap</item>
        <item name="android:background">@drawable/punica_bg_row_icon</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="tint">@color/emulator_menu_on_surface</item>
    </style>

    <!-- A row's switch: the app's 64 x 32 dp pill (punica_switch_track / _thumb), 12 dp after the text -->
    <style name="Widget.Pomegrade.EmulatorSettings.Switch" parent="">
        <item name="android:layout_marginStart">@dimen/emulator_settings_gap_wide</item>
        <item name="android:background">@null</item>
        <item name="android:thumb">@drawable/punica_switch_thumb</item>
        <item name="track">@drawable/punica_switch_track</item>
        <item name="thumbTint">@null</item>
        <item name="trackTint">@null</item>
        <item name="showText">false</item>
        <item name="switchMinWidth">64dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
    </style>

    <!-- A row's button at its end (more settings, options): 48 dp touch, 12 dp after the text -->
    <style name="Widget.Pomegrade.EmulatorSettings.EndButton" parent="Widget.Material3.Button.IconButton">
        <item name="android:layout_marginStart">@dimen/emulator_settings_gap_wide</item>
        <item name="android:minWidth">@dimen/emulator_settings_touch</item>
        <item name="android:minHeight">@dimen/emulator_settings_touch</item>
        <item name="iconSize">@dimen/emulator_settings_icon</item>
        <item name="iconTint">@color/emulator_menu_on_surface</item>
    </style>

    <!-- A row's "use the global setting" / "reset" button, under its text, 8 dp below it -->
    <style name="Widget.Pomegrade.EmulatorSettings.RowButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_marginTop">@dimen/emulator_settings_gap</item>
    </style>

    <!-- A section title, outside the cards: Bricolage Grotesque 16, 16 dp above, 8 below -->
    <style name="Widget.Pomegrade.EmulatorSettings.Section" parent="">
        <item name="android:paddingStart">@dimen/emulator_settings_margin</item>
        <item name="android:paddingEnd">@dimen/emulator_settings_margin</item>
        <item name="android:paddingTop">@dimen/emulator_settings_margin</item>
        <item name="android:paddingBottom">@dimen/emulator_settings_gap</item>
    </style>

    <style name="TextAppearance.Pomegrade.EmulatorSettings.Title" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">14sp</item>
        <item name="lineHeight">20sp</item>
        <item name="android:textColor">@color/emulator_menu_on_surface</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Pomegrade.EmulatorSettings.Summary" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="lineHeight">16sp</item>
        <item name="android:textColor">@color/emulator_menu_on_surface_variant</item>
    </style>

    <!-- the value a row is set to, under its summary: the summary's grey, as the DS settings show a chosen option
         (red before 31 October, which no other screen used) -->
    <style name="TextAppearance.Pomegrade.EmulatorSettings.Value" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="lineHeight">16sp</item>
        <item name="android:textColor">@color/emulator_menu_on_surface_variant</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Pomegrade.EmulatorSettings.Section" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">16sp</item>
        <item name="lineHeight">24sp</item>
        <item name="android:textColor">@color/emulator_menu_on_surface</item>
        <item name="fontFamily">@font/punica_bricolage_grotesque_bold</item>
        <item name="android:fontFamily">@font/punica_bricolage_grotesque_bold</item>
    </style>
</resources>
