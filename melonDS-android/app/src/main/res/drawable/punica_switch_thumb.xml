<?xml version="1.0" encoding="utf-8"?>
<!-- Punica's switch thumb: a 16 dp dot inside a 24 dp square (4 dp from the track's edge), white when on, grey when off -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <inset android:inset="4dp">
            <shape android:shape="oval">
                <size android:width="16dp" android:height="16dp" />
                <solid android:color="@color/punicaText" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:inset="4dp">
            <shape android:shape="oval">
                <size android:width="16dp" android:height="16dp" />
                <solid android:color="@color/punicaTextMuted" />
            </shape>
        </inset>
    </item>
</selector>
