<?xml version="1.0" encoding="utf-8"?>
<!-- Punica's switch track: 48 x 24 dp pill, red when on, the raised card with its outline when off -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <size android:width="48dp" android:height="24dp" />
            <solid android:color="@color/punicaRed" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <size android:width="48dp" android:height="24dp" />
            <solid android:color="@color/punicaCardRaised" />
            <stroke android:width="1dp" android:color="@color/punicaLine" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
