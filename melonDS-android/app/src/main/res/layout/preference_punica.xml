<?xml version="1.0" encoding="utf-8"?>
<!-- Punica's settings row (every preference but categories): at least 64 dp high, 16 dp side padding, the icon on a
     32 dp tile, the title 14 sp and the summary 12 sp under it, the widget at the end. The card behind the rows is
     drawn by PunicaPreferenceCards -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:minHeight="@dimen/punica_row_min_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/punica_margin"
    android:paddingEnd="@dimen/punica_margin">

    <FrameLayout
        android:id="@+id/icon_frame"
        android:layout_width="@dimen/punica_row_icon"
        android:layout_height="@dimen/punica_row_icon"
        android:layout_marginEnd="@dimen/punica_gap_wide"
        android:background="@drawable/bg_punica_row_icon">

        <ImageView
            android:id="@android:id/icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="@dimen/punica_gap_wide"
        android:paddingBottom="@dimen/punica_gap_wide">

        <TextView
            android:id="@android:id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/punicaText"
            android:textSize="14sp"
            android:lineHeight="20sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@android:id/summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="10"
            android:textColor="@color/punicaTextMuted"
            android:textSize="12sp"
            android:lineHeight="16sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@android:id/widget_frame"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/punica_gap_wide" />
</LinearLayout>
