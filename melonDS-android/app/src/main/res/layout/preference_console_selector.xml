<?xml version="1.0" encoding="utf-8"?>
<!-- The settings' console picker: one logo card per console, two by two (wide logos stay readable on a
     phone), the GameCube and Wii one on a row of its own; tapping one shows that console's settings -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/settings_console_gba"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/settings_console_card"
            android:contentDescription="@string/settings_section_gba"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/settings_console_logo_gba" />

        <ImageView
            android:id="@+id/settings_console_ds"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/settings_console_card"
            android:contentDescription="@string/settings_section_ds"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/settings_console_logo_ds" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/settings_console_three_ds"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/settings_console_card"
            android:contentDescription="@string/settings_section_three_ds"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/settings_console_logo_three_ds" />

        <ImageView
            android:id="@+id/settings_console_switch"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/settings_console_card"
            android:contentDescription="@string/settings_section_switch"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/settings_console_logo_switch" />
    </LinearLayout>

    <ImageView
        android:id="@+id/settings_console_gc_wii"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/settings_console_card"
        android:contentDescription="@string/settings_section_gc_wii"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/settings_console_logo_gc_wii" />
</LinearLayout>
