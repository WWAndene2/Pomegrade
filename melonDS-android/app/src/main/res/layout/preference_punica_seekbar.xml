<?xml version="1.0" encoding="utf-8"?>
<!-- Punica's slider row (SeekBarPreference): the row of preference_punica, the slider under the title, red, its value
     at the end -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:minHeight="@dimen/punica_row_min_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/punica_margin"
    android:paddingEnd="@dimen/punica_margin">

    <FrameLayout
        android:id="@+id/icon_frame"
        android:layout_width="@dimen/punica_row_icon"
        android:layout_height="@dimen/punica_row_icon"
        android:layout_marginEnd="@dimen/punica_gap_wide"
        android:background="@drawable/punica_bg_row_icon">

        <ImageView
            android:id="@android:id/icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="@dimen/punica_gap_wide"
        android:paddingBottom="@dimen/punica_gap_wide">

        <TextView
            android:id="@android:id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:lineHeight="20sp"
            android:maxLines="2"
            android:textColor="@color/punicaText"
            android:textSize="14sp" />

        <TextView
            android:id="@android:id/summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineHeight="16sp"
            android:maxLines="10"
            android:textColor="@color/punicaTextMuted"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/punica_row_icon"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <SeekBar
                android:id="@+id/seekbar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:progressBackgroundTint="@color/punicaCardRaised"
                android:progressTint="@color/punicaRed"
                android:thumbTint="@color/punicaText" />

            <TextView
                android:id="@+id/seekbar_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:minWidth="@dimen/punica_touch"
                android:paddingStart="@dimen/punica_gap"
                android:textColor="@color/punicaTextMuted"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
